#!/usr/bin/env python3
"""Record the exact stream and mirror it as safe text to the console."""

import codecs
import os
import sys


CONTROLS = {
    code: f"\\x{code:02x}"
    for code in (*range(0x20), *range(0x7F, 0xA0))
    if code not in (ord("\t"), ord("\n"))
}


def display_text(fd, text):
    data = memoryview(text.translate(CONTROLS).encode("utf-8"))
    try:
        while data:
            data = data[os.write(fd, data):]
    except OSError:
        # An unavailable console must not interrupt the binary receipt.
        return None
    return fd


def record_output(source, capture, display_fd):
    decoder = codecs.getincrementaldecoder("utf-8")(errors="backslashreplace")
    while chunk := source.read1(65536):
        capture.write(chunk)
        capture.flush()
        if display_fd is not None:
            display_fd = display_text(display_fd, decoder.decode(chunk))
    if display_fd is not None:
        display_text(display_fd, decoder.decode(b"", final=True))


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: fbterm-output FILE")
    with open(sys.argv[1], "wb") as capture:
        record_output(sys.stdin.buffer, capture, sys.stdout.fileno())
