#!/usr/bin/env bash

umask 077

export HISTFILE=/dev/null
set +o history 2>/dev/null || true

printf '\n'
printf '========================================\n'
printf ' FrameBridge Terminal R1\n'
printf ' PTY persistente / comandos controlados\n'
printf '========================================\n'
printf '\n'

# This pane displays jobs. Control records arrive over the private FIFO.
exec /usr/bin/python3 "${FBTERM_ROOT:?}/bin/fbterm_engine.py" serve
