#!/usr/bin/python3 -I
"""Desktop-session entry point; the runtime works without a graphical session."""
import os
import sys
if os.getuid() == 0 or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
    raise SystemExit(0)
sys.path.insert(0,"/usr/lib/framebridge-expanded/expanded")
from framebridge_expanded.activity_ui import main
raise SystemExit(main())
