def _owned_directory(fd, *, private=False):
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise RuntimeError("Runtime directory ownership is unsafe")
    if info.st_mode & 0o022 or (private and stat.S_IMODE(info.st_mode) != 0o700):
        raise RuntimeError("Runtime directory permissions are unsafe")


def _child_directory(parent, name, *, private=False):
    try:
        os.mkdir(name, 0o700, dir_fd=parent)
    except FileExistsError:
        pass
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                 dir_fd=parent)
    try:
        _owned_directory(fd)
        if private:
            os.fchmod(fd, 0o700)
            _owned_directory(fd, private=True)
        return fd
    except BaseException:
        os.close(fd)
        raise


def _profile_directory(root, relative, *, private=False):
    fd = os.dup(root)
    try:
        parts = Path(relative).parts
        if any(part in ("", ".", "..", "/") for part in parts):
            raise RuntimeError("Invalid profile directory")
        for index, part in enumerate(parts):
            child = _child_directory(fd, part, private=private and index == len(parts) - 1)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


@contextmanager
def _layout_lock(state_fd):
    fd = os.open("layout-migration.lock",
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                 0o600, dir_fd=state_fd)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
            raise RuntimeError("Unsafe layout lock")
        deadline = time.monotonic() + 10
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError("Another layout preparation is in progress") from None
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def _entry(fd, name):
    """Identity and target of an entry; never follow or read a regular file."""
    try:
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        return None
    target = os.readlink(name, dir_fd=fd) if stat.S_ISLNK(info.st_mode) else None
    return (info.st_dev, info.st_ino, stat.S_IFMT(info.st_mode), info.st_uid, target)


def _move_noreplace(src_fd, src, dst_fd, dst):
    """Linux atomic rename that cannot overwrite any destination entry."""
    libc = ctypes.CDLL(None, use_errno=True)
    rename = getattr(libc, "renameat2", None)
    if rename is None:
        raise RuntimeError("Safe layout migration requires Linux renameat2")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
                       ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(src_fd, os.fsencode(src), dst_fd, os.fsencode(dst), 1) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))


def _write_new(fd, name, data):
    out = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW |
                  os.O_CLOEXEC, 0o600, dir_fd=fd)
    with os.fdopen(out, "wb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    os.fsync(fd)


def _check_layout_journals(state_fd):
    # A killed process can leave entries quarantined. Never guess whether
    # they are safe to discard, and never resume an unfinished transaction.
    for name in os.listdir(state_fd):
        if not name.startswith("layout-migration-") or name.endswith(".json"):
            continue
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                     dir_fd=state_fd)
        try:
            _owned_directory(fd, private=True)
            valid = []
            for marker, expected in (("committed", b"complete\n"), ("rolled-back", b"restored\n")):
                value = _entry(fd, marker)
                if value is None:
                    continue
                try:
                    marker_fd = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW |
                                        os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)
                    try:
                        info = os.fstat(marker_fd)
                        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600
                                or os.read(marker_fd, 32) != expected):
                            raise RuntimeError("Invalid layout completion marker")
                    finally:
                        os.close(marker_fd)
                except OSError:
                    raise RuntimeError("Invalid layout completion marker") from None
                valid.append(marker)
            if len(valid) != 1:
                raise RuntimeError("Unfinished layout migration; preserve and review " + name)
        finally:
            os.close(fd)


def _legacy_target(raw, src):
    old_root = PREFIX / "original"
    previous = Path(raw)
    try:
        before = previous.relative_to(old_root).parts
        after = src.relative_to(old_root).parts
    except ValueError:
        return False
    return (previous.is_absolute() and raw == str(previous)
            and os.path.normpath(raw) == raw
            and len(before) >= 2 and len(after) >= 2
            and before[0] != after[0] and before[1:] == after[1:]
            and not previous.exists()
            and previous.resolve().is_relative_to(old_root.resolve()))


def _rollback_layout(rows, journal):
    complete = True
    for row in reversed(rows):
        fd, name, index = row["fd"], row["name"], row["index"]
        backup = "old-" + str(index)
        try:
            # Infer the actual outcome from the directory entries. A signal or
            # an exception can arrive after a successful syscall and before a
            # Python bookkeeping assignment. Never trust such flags alone.
            current = _entry(fd, name)
            saved = _entry(journal, backup)
            expected_new = row.get("new_identity")
            if expected_new is not None and current == expected_new:
                displaced = "rollback-new-" + str(index)
                _move_noreplace(fd, name, journal, displaced)
                if _entry(journal, displaced) != expected_new:
                    # A non-cooperating process changed the entry between
                    # observation and rename. Preserve it and try to restore.
                    try:
                        _move_noreplace(journal, displaced, fd, name)
                    except OSError:
                        pass
                    complete = False
            if saved is not None:
                if _entry(fd, name) is None:
                    _move_noreplace(journal, backup, fd, name)
                else:
                    complete = False
            # A completed rollback requires the exact original identity. A
            # different entry is retained, but does not certify restoration.
            if (_entry(fd, name) != row["old"]
                    or _entry(journal, backup) is not None):
                complete = False
            os.fsync(fd)
            os.fsync(journal)
        except (OSError, RuntimeError):
            # All displaced entries remain in the journal. Fail closed even
            # if a recovery syscall completed just before reporting failure.
            complete = False
    return complete


def _prepare_links(state_fd, stack):
    _check_layout_journals(state_fd)
    links = {
        "home/.local/share/framebridge/fbterm/bin": PREFIX / LAYOUT["fbterm_bin"],
        "home/.local/share/framebridge/tool-adapter/bin": PREFIX / LAYOUT["adapter_bin"],
        "home/.local/lib/framebridge-native/host": PREFIX / LAYOUT["native_host_dir"],
        "home/Descargas/framebridge_v0_1/host": PREFIX / LAYOUT["native_host_dir"],
    }
    rows = []
    for relative, src in links.items():
        if (not src.is_dir()
                or not src.resolve().is_relative_to((PREFIX / "original").resolve())):
            raise RuntimeError("Missing or unsafe packaged runtime path: " + str(src))
        path = Path(relative)
        parent = _profile_directory(state_fd, path.parent, private=True)
        stack.callback(os.close, parent)
        old = _entry(parent, path.name)
        if old is not None:
            if old[2] != stat.S_IFLNK or old[3] != os.getuid():
                raise RuntimeError("Unexpected runtime entry: " + relative)
            if old[4] == str(src):
                continue
            if not _legacy_target(old[4], src):
                raise RuntimeError("Unexpected link: " + relative)
        rows.append({"relative": relative, "fd": parent, "name": path.name,
                     "src": src, "old": old, "index": len(rows)})
    if not rows:
        return

    name = "layout-migration-" + secrets.token_hex(16)
    os.mkdir(name, 0o700, dir_fd=state_fd)
    journal = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                      dir_fd=state_fd)
    stack.callback(os.close, journal)
    _owned_directory(journal, private=True)
    os.fsync(state_fd)
    manifest = {"schema": 1, "entries": [
        {"path": row["relative"], "previous": row["old"][4] if row["old"] else None,
         "new": str(row["src"]), "backup": "old-" + str(row["index"])}
        for row in rows]}
    _write_new(journal, "manifest.json", (json.dumps(manifest, indent=2) + "\n").encode())
    try:
        for row in rows:
            fd, dst, index = row["fd"], row["name"], row["index"]
            staged = "new-" + str(index)
            os.symlink(str(row["src"]), staged, dir_fd=journal, target_is_directory=True)
            row["new_identity"] = _entry(journal, staged)
            os.fsync(journal)
            if _entry(fd, dst) != row["old"]:
                raise RuntimeError("Runtime entry changed during preparation")
            if row["old"] is not None:
                backup = "old-" + str(index)
                # The displaced entry is retained, not deleted, even if an
                # uncooperative process changed the pathname after the check.
                _move_noreplace(fd, dst, journal, backup)
                row["moved"] = True
                os.fsync(journal)
                os.fsync(fd)
                if _entry(journal, backup) != row["old"]:
                    raise RuntimeError("Unexpected concurrent runtime entry; preserving it")
            _move_noreplace(journal, staged, fd, dst)
            row["installed"] = True
            os.fsync(fd)
            os.fsync(journal)
            if _entry(fd, dst) != row["new_identity"]:
                raise RuntimeError("Runtime entry changed after installation")
        for row in rows:
            if _entry(row["fd"], row["name"]) != row["new_identity"]:
                raise RuntimeError("Runtime entry changed before commit")
    except BaseException:
        if _rollback_layout(rows, journal):
            _write_new(journal, "rolled-back", b"restored\n")
        # Otherwise the unfinished journal stops later preparation. It retains
        # original/displaced entries; no automatic destructive recovery.
        raise
    # Do not roll back after beginning to write the completion marker. If
    # durability cannot be established, preserve the journal and all entries.
    _write_new(journal, "committed", b"complete\n")


def prepare(args):
    state, home, env = settings(args)
    if home != state / "home":
        raise RuntimeError("Unexpected profile home")
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    state_fd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with ExitStack() as stack:
        stack.callback(os.close, state_fd)
        _owned_directory(state_fd)
        os.fchmod(state_fd, 0o700)
        with _layout_lock(state_fd):
            runtime = Path(env["XDG_RUNTIME_DIR"])
            runtime.mkdir(mode=0o700, exist_ok=True)
            runtime_fd = os.open(runtime, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW |
                                 os.O_CLOEXEC)
            stack.callback(os.close, runtime_fd)
            _owned_directory(runtime_fd, private=True)
            for name in ("tmp", "tmux", "adapter"):
                os.close(_child_directory(runtime_fd, name, private=True))
            for relative in ("home", "run", "tmp", "tmux", "logs",
                             "home/.config/framebridge", "home/.local/share/framebridge/fbterm",
                             "home/.local/share/framebridge/tool-adapter",
                             "home/.local/lib/framebridge-native", "home/Descargas/framebridge_v0_1"):
                os.close(_profile_directory(state_fd, relative, private=True))
            _prepare_links(state_fd, stack)
            registry_fd = _profile_directory(state_fd, "home/.config/framebridge", private=True)
            try:
                current = _entry(registry_fd, "nodes.json")
                if current is None:
                    _write_new(registry_fd, "nodes.json", b'{\n  "nodes": {}\n}\n')
                elif current[2] != stat.S_IFREG or current[3] != os.getuid():
                    raise RuntimeError("Unexpected node registry entry")
            finally:
                os.close(registry_fd)
    return state, home, env


def birth(pid):
    try:
        fields = Path("/proc/" + str(pid) + "/stat").read_text().rsplit(") ", 1)[1].split()
        if fields[0] in {"Z", "X"}:
            return None
        return fields[19]
    except (OSError, IndexError):
        return None

def live(record):
    expected = record.get("birth")
    return expected is not None and birth(record["pid"]) == expected

def load_record(state):
    p = state / "processes.json"
    if not p.exists():
        return {"processes": []}
    return json.loads(p.read_text())

def stop(args):
    state, home, env = settings(args)
    records = load_record(state)
    for rec in reversed(records.get("processes", [])):
        if live(rec):
            os.killpg(rec["pid"], signal.SIGTERM)
    deadline = time.monotonic() + 5
    while any(live(r) for r in records.get("processes", [])) and time.monotonic() < deadline:
        time.sleep(.1)
    for rec in records.get("processes", []):
        if live(rec):
            os.killpg(rec["pid"], signal.SIGKILL)
    if Path(env["TMUX_TMPDIR"]).is_dir() and shutil.which("tmux"):
        subprocess.run(["tmux", "kill-server"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (state / "processes.json").unlink(missing_ok=True)
    print("FrameBridge Original detenido. Estado: " + str(state))

def start(args):
    missing = [name for name in CORE_COMMANDS if not shutil.which(name)]
    if missing:
        raise RuntimeError("Faltan comandos para ejecutar FrameBridge Original: " + ", ".join(missing))
    state, home, env = prepare(args)
    records = load_record(state)
    if any(live(r) for r in records.get("processes", [])):
        raise RuntimeError("Este perfil ya está ejecutándose; usa status o stop.")
    for port in (args.port, args.hub_port):
        with socket.socket() as probe:
            probe.bind(("127.0.0.1", port))
    commands = [
        ("adapter", [sys.executable, str(PREFIX / LAYOUT["adapter"]), "serve"]),
        ("fleet", [sys.executable, str(PREFIX / "original/hub/FrameBridge-Fleet-Hub/app/fleet_hub_mcp_server.py")]),
        ("mcp", [sys.executable, str(PREFIX / "portable/front_door_mcp.py")]),
    ]
    record = {"state_dir": str(state), "mcp_url": "http://127.0.0.1:" + str(args.port) + "/mcp",
              "port": args.port, "hub_port": args.hub_port, "processes": []}
    try:
        for role, command in commands:
            log = (state / "logs" / (role + ".log")).open("ab")
            proc = subprocess.Popen(command, env=env, cwd=home, stdin=subprocess.DEVNULL,
                                    stdout=log, stderr=subprocess.STDOUT, start_new_session=True, umask=0o077)
            log.close()
            record["processes"].append({"role": role, "pid": proc.pid, "birth": birth(proc.pid)})
        (state / "processes.json").write_text(json.dumps(record, indent=2) + "\n")
        (state / "processes.json").chmod(0o600)
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            if not all(live(r) for r in record["processes"]):
                raise RuntimeError("Falló un proceso. Consulta los logs del perfil: " + str(state / "logs"))
            ready = (Path(env["FRAMEBRIDGE_TOOL_ROOT"]) / "adapter.sock").is_socket()
            for port in (args.port, args.hub_port):
                try:
                    with socket.create_connection(("127.0.0.1", port), timeout=.2):
                        pass
                except OSError:
                    ready = False
            if ready:
                print("FrameBridge Original iniciado: " + record["mcp_url"])
                print("Conexión a ChatGPT: manual; usa tunnel --help y las instrucciones del paquete.")
                print("Perfil local: " + str(state))
                return
            time.sleep(.15)
        raise RuntimeError("No se completó el arranque; consulta los logs del perfil.")
    except BaseException:
        stop(args)
        raise

def status(args):
    state, home, env = settings(args)
    record = load_record(state)
    print(json.dumps({"state_dir": str(state), "mcp_url": record.get("mcp_url"),
        "processes": [{"role": x["role"], "pid": x["pid"], "running": live(x)}
                      for x in record.get("processes", [])]}, indent=2))

def doctor(args):
    state, home, env = settings(args)
    required = CORE_COMMANDS
    gui = ["xdotool", "xwininfo", "xclip", "import", "convert", "identify", "xterm"]
    imports = subprocess.run([sys.executable, "-c", "import mcp,pydantic_core,cryptography"], env=env, capture_output=True)
    report = {"python": sys.version.split()[0], "python_abi_expected": "3.13",
              "mcp_imports_ok": imports.returncode == 0,
              "core_commands": {x: bool(shutil.which(x)) for x in required},
              "cua_commands": {x: bool(shutil.which(x)) for x in gui},
              "display": os.environ.get("DISPLAY", ""),
              "tunnel_sha256": hashlib.sha256((PREFIX / "original/hub/FrameBridge-MCP-Private/bin/tunnel-client").read_bytes()).hexdigest()}
    print(json.dumps(report, indent=2))
    return 0 if sys.version_info[:2] == (3, 13) and imports.returncode == 0 and all(report["core_commands"].values()) else 1

def main():
    parser = argparse.ArgumentParser(description="FrameBridge Original: ejecución local, CUA y conexión manual a ChatGPT.")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE))
    parser.add_argument("--port", type=int, default=19865)
    parser.add_argument("--hub-port", type=int, default=19877)
    parser.add_argument("--broker-port", type=int, default=19878)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ["start", "stop", "status", "doctor"]:
        sub.add_parser(name)
    tunnel = sub.add_parser("tunnel", help="Ejecuta el cliente de túnel original; configuración manual independiente.")
    tunnel.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command == "tunnel":
        state, home, env = prepare(args)
        rest = args.arguments
        if rest[:1] == ["--"]:
            rest = rest[1:]
        explicit_refs = {x[4:] for x in rest if x.startswith("env:")}
        for x in rest:
            if "=env:" in x:
                explicit_refs.add(x.split("=env:", 1)[1])
        for key in list(env):
            if (key.startswith(("TUNNEL_CLIENT_", "CONTROL_PLANE_", "OPENAI_", "MCP_", "HEALTH_", "LOG_", "CLOUDFLARED_", "HARPOON_"))
                    or key in {"TUNNEL_ID", "TUNNEL_BIN", "CRED_FILE", "OPEN_WEB_UI", "PID_FILE",
                               "ALLOW_REMOTE_UI", "ADMIN_UI_LOG_BUFFER_EVENTS", "PROXY_CHECK_INTERVAL"}):
                if key not in explicit_refs:
                    env.pop(key, None)
        os.execve(str(PREFIX / "original/hub/FrameBridge-MCP-Private/bin/tunnel-client"),
                  ["tunnel-client"] + rest, env)
    if args.command == "start" and PREFIX.resolve() == Path("/usr/lib/framebridge-expanded"):
        sys.path.insert(0, str(PREFIX / "expanded"))
        from framebridge_expanded.package_maintenance import runtime_guard
        with runtime_guard(PREFIX):
            result = globals()[args.command](args)
    else:
        result = globals()[args.command](args)
    return result or 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
