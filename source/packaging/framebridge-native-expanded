#!/usr/bin/python3
"""Private captured-host entry point with installed-prefix discovery."""
import os
import sys
from pathlib import Path
prefix = Path(__file__).resolve().parents[1]
os.environ.setdefault("FRAMEBRIDGE_EXPANDED_PREFIX", str(prefix))
sys.path.insert(0, str(prefix / "expanded"))
from framebridge_expanded.native_host import main
main()
